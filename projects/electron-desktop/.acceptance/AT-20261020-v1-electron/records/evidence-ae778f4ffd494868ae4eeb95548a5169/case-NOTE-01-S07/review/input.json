  "requirement": {
    "id": "NOTE-01",
    "title": "NOTE-01",
    "text": "可以新建、选择、编辑、删除便签。每个便签有不变的独立 ID；两个同标题便签独立编辑、删除。"
  },
  "scene": {
    "id": "NOTE-01-S07",
    "title": "新增便签保留已有记录",
    "priority": "P0",
    "priority_reason": "新增时覆盖或移除已有便签会损失用户原始记录，且输入未确认恢复途径。",
    "description": "已有一条成功保存的普通便签时，新建并保存另一条不同标题、正文的普通便签，确认两条分别存在且可选择，原便签标题和正文保持原值。新增及结果状态下，两条便签的列表项、当前标题、正文和必要控件可见可读、可操作且无遮挡或裁切，排版层次、间距、对齐、字体与控件样式协调，符合项目已有风格并具有基本视觉完成度。",
    "requirement_id": "NOTE-01",
    "kind": "BLACK_BOX"
  },
  "business_goal": "交付可在实际 Electron 桌面应用中操作的便签功能，支持独立管理便签、校验保存内容、持久化与用户数据隔离，并保证文本展示、数据访问及退出行为安全可靠。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "NOTE-01",
      "NOTE-02",
      "NOTE-03",
      "NOTE-04",
      "NOTE-05",
      "NOTE-06"
    ],
    "exclusions": [
      "其他同时运行的 Electron 应用的进程管理。",
      "视觉风格、审美、配色方案与装饰性布局的评分。",
      "非法保存的具体错误文案，以及越界 ID 被拒绝时的具体报错形式。"
    ],
    "limitations": [
      "用户限定本轮工作止于准备及 catalog，不执行业务场景；六项需求均保留在验收范围内，目前尚无实际运行验证结果。",
      "输入未给出正常应用窗口的具体尺寸；后续视觉判断需记录窗口尺寸与直接视觉证据，每个 UI 场景均须覆盖操作、可读性、无遮挡及合理布局检查。",
      "实际验收须运行 Electron 桌面应用并经过真实用户操作流程，不能仅以单元调用证明；应支持独立用户数据目录，且不依赖公网或真实用户数据。",
      "输入未展开 README 的构建启动细节及共享判据文档的完整内容，具体便签 IPC 接口也未明确。"
    ]
  },
  "related_requirements": [
    {
      "id": "NOTE-02",
      "title": "NOTE-02",
      "text": "标题去除首尾空白后必须为 1 至 80 个 Unicode 码点，正文为 0 至 10000 个 Unicode 码点。非法保存显示可见错误且不覆盖最近一次成功保存；错误文案不作要求。"
    },
    {
      "id": "NOTE-03",
      "title": "NOTE-03",
      "text": "成功保存后完全退出应用再启动，标题与正文一致；删除结果也保留。不同用户数据目录互不影响。"
    },
    {
      "id": "NOTE-06",
      "title": "NOTE-06",
      "text": "未选择便签时，保存/删除不得损坏现有数据；关闭后没有残留的本应用 Electron 进程。其他同时运行的 Electron 应用不在本需求范围内。"
    }
  ],
