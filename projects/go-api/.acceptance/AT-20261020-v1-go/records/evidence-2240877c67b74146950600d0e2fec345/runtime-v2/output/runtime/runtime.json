      "import http.client,pathlib,socket,subprocess,sys,tempfile,time\nbinary=sys.argv[1]\nwith tempfile.TemporaryDirectory(prefix='stock-smoke-',dir=sys.argv[2]) as work:\n    with socket.socket() as listener:\n        listener.bind(('127.0.0.1',0))\n        port=listener.getsockname()[1]\n    with tempfile.TemporaryFile(mode='w+b',dir=work) as log:\n        process=subprocess.Popen([binary,'--port',str(port),'--state-dir',str(pathlib.Path(work)/'state')],stdout=log,stderr=subprocess.STDOUT)\n        try:\n            deadline=time.monotonic()+15\n            while True:\n                if process.poll() is not None:\n                    log.seek(0)\n                    raise RuntimeError('server exited: '+log.read().decode(errors='replace'))\n                connection=http.client.HTTPConnection('127.0.0.1',port,timeout=1)\n                try:\n                    connection.request('GET','/__runtime_smoke__')\n                    response=connection.getresponse()\n                    if process.poll() is not None:\n                        raise RuntimeError('server exited during smoke')\n                    print('HTTP transport ready')\n                    break\n                except (OSError,http.client.HTTPException):\n                    if time.monotonic()>=deadline:\n                        log.seek(0)\n                        raise RuntimeError('server readiness timeout: '+log.read().decode(errors='replace'))\n                    time.sleep(0.05)\n                finally:\n                    connection.close()\n        finally:\n            if process.poll() is None:\n                process.terminate()\n            try:\n                process.wait(timeout=5)\n            except subprocess.TimeoutExpired:\n                process.kill()\n                process.wait(timeout=5)",
