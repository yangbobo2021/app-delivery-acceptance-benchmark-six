  "requirement": {
    "id": "STOCK-02",
    "title": "STOCK-02",
    "text": "STOCK-02：`POST /reserve` 接收 JSON `request_id` 和 `quantity`。request_id 为非空字符串，quantity 为 1 至 10 的整数；合法且库存充足时以 201 返回 `request_id,quantity,available`，库存恰好减少该数量。"
  },
  "scene": {
    "id": "STOCK-02-S01",
    "title": "普通合法预留正确返回并累计扣减",
    "priority": "P0",
    "priority_reason": "普通合法请求无法成功或库存扣减错误，会直接破坏主要预留流程。",
    "description": "初始库存为10，依次以不同的普通非空 request_id 预留3和2。两次均返回201，JSON中的 request_id、quantity 分别与本次输入一致，available 分别为7和5；每次通过 GET /stock 核对实际库存与该次 available 一致。",
    "requirement_id": "STOCK-02",
    "kind": "BLACK_BOX"
  },
  "business_goal": "提供初始库存为10的本地库存预留HTTP服务，支持库存查询、合法预留和幂等重试，确保并发不超扣、无效请求不改变状态，正常重启后保留库存及成功预留记录，并实现状态目录隔离；启动端口和状态目录可配置。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "STOCK-01",
      "STOCK-02",
      "STOCK-03",
      "STOCK-04",
      "STOCK-05",
      "STOCK-06"
    ],
    "exclusions": [
      "身份系统",
      "对外部网络服务的依赖"
    ],
    "limitations": [
      "额外JSON字段的接受或拒绝均允许，没有唯一预期。",
      "持久化要求覆盖成功HTTP响应返回后正常关闭再启动，异常终止或断电后的保证未规定。"
    ]
  },
  "related_requirements": [
    {
      "id": "STOCK-01",
      "title": "STOCK-01",
      "text": "STOCK-01：`GET /stock` 返回 JSON `available`，表示当前可用库存，成功状态为 200。"
    },
    {
      "id": "STOCK-03",
      "title": "STOCK-03",
      "text": "STOCK-03：同 request_id、同 quantity 的成功预留重试，返回 200 及首次预留的响应内容，不再次扣减。相同 request_id 换 quantity 返回 409，不改变库存。"
    },
    {
      "id": "STOCK-04",
      "title": "STOCK-04",
      "text": "STOCK-04：库存不足返回 409，不扣减。并发不同 request_id 的请求不能使库存为负；成功扣减总数不得超过初始库存。并发同 request_id 不得重复扣减。"
    },
    {
      "id": "STOCK-05",
      "title": "STOCK-05",
      "text": "STOCK-05：缺失必填字段、坏 JSON、非整数/超范围 quantity 返回 400，不改变状态。额外 JSON 字段的接受或拒绝均允许。"
    },
    {
      "id": "STOCK-06",
      "title": "STOCK-06",
      "text": "STOCK-06：在一次成功 HTTP 响应返回后正常关闭再启动，库存及成功 request_id 的幂等记录必须保留；不同状态目录互不影响。"
    }
  ],
