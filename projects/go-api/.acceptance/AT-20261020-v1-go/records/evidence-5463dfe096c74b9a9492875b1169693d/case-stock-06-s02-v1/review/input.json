  "requirement": {
    "id": "STOCK-06",
    "title": "STOCK-06",
    "text": "STOCK-06：在一次成功 HTTP 响应返回后正常关闭再启动，库存及成功 request_id 的幂等记录必须保留；不同状态目录互不影响。"
  },
  "scene": {
    "id": "STOCK-06-S02",
    "title": "正常重启后成功请求不重复扣减",
    "priority": "P0",
    "priority_reason": "成功标识丢失会使已完成的同一业务请求再次占用有限库存。",
    "description": "成功预留3件并确认201响应完整返回后正常关闭，以同一状态目录重新启动；使用原 request_id 和 quantity 重试，应返回200，重试前后的可用库存均为7。",
    "requirement_id": "STOCK-06",
    "kind": "BLACK_BOX"
  },
  "business_goal": "提供初始库存为10的本地库存预留HTTP服务，支持库存查询、合法预留和幂等重试，确保并发不超扣、无效请求不改变状态，正常重启后保留库存及成功预留记录，并实现状态目录隔离；启动端口和状态目录可配置。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "STOCK-01",
      "STOCK-02",
      "STOCK-03",
      "STOCK-04",
      "STOCK-05",
      "STOCK-06"
    ],
    "exclusions": [
      "身份系统",
      "对外部网络服务的依赖"
    ],
    "limitations": [
      "额外JSON字段的接受或拒绝均允许，没有唯一预期。",
      "持久化要求覆盖成功HTTP响应返回后正常关闭再启动，异常终止或断电后的保证未规定。"
    ]
  },
  "related_requirements": [
    {
      "id": "STOCK-01",
      "title": "STOCK-01",
      "text": "STOCK-01：`GET /stock` 返回 JSON `available`，表示当前可用库存，成功状态为 200。"
    },
    {
      "id": "STOCK-02",
      "title": "STOCK-02",
      "text": "STOCK-02：`POST /reserve` 接收 JSON `request_id` 和 `quantity`。request_id 为非空字符串，quantity 为 1 至 10 的整数；合法且库存充足时以 201 返回 `request_id,quantity,available`，库存恰好减少该数量。"
    },
    {
      "id": "STOCK-03",
      "title": "STOCK-03",
      "text": "STOCK-03：同 request_id、同 quantity 的成功预留重试，返回 200 及首次预留的响应内容，不再次扣减。相同 request_id 换 quantity 返回 409，不改变库存。"
    }
  ],
