        "/Users/boboyang/work/app-delivery-acceptance-v1-web-electron/projects/ts-web/.acceptance-local/AT-20261020-v1-web/workflows/runtime-1/runtime/runtime/browser-tools/environment-smoke.test.cjs",
        "const {test} = require('node:test');\nconst {spawn} = require('node:child_process');\nconst {once} = require('node:events');\nconst {createInterface} = require('node:readline');\nconst {chromium} = require('playwright');\n\ntest('browser runtime and project server entry', {timeout:45000}, async t => {\n  const server = spawn(process.execPath, ['server.mjs', '0'], {\n    cwd:process.cwd(), env:{...process.env, PORT:'0'},\n    stdio:['ignore','pipe','pipe']\n  });\n  server.stderr.pipe(process.stderr);\n  t.after(async () => {\n    if (server.pid && server.exitCode === null && server.signalCode === null) {\n      const stopped = once(server, 'exit');\n      server.kill('SIGTERM');\n      const force = setTimeout(() => server.kill('SIGKILL'), 2000);\n      force.unref();\n      try { await stopped; } finally { clearTimeout(force); }\n    }\n  });\n  const lines = createInterface({input:server.stdout});\n  let startupTimer;\n  let port;\n  try {\n    port = await Promise.race([\n      once(lines, 'line').then(([line]) => JSON.parse(line).port),\n      once(server, 'error').then(([error]) => { throw error; }),\n      once(server, 'exit').then(([code,signal]) => { throw new Error('Server exited before readiness: '+code+' '+signal); }),\n      new Promise((_,reject) => { startupTimer = setTimeout(() => reject(new Error('Server readiness timeout')), 10000); })\n    ]);\n  } finally {\n    clearTimeout(startupTimer);\n    lines.close();\n  }\n  if (!Number.isInteger(port) || port <= 0) throw new Error('Invalid server port');\n  const browser = await chromium.launch({headless:true, timeout:15000});\n  t.after(() => browser.close());\n  const context = await browser.newContext({viewport:{width:1280,height:800}});\n  const page = await context.newPage();\n  const scriptResponse = page.waitForResponse(response => new URL(response.url()).pathname === '/app.js', {timeout:15000});\n  const [document,script] = await Promise.all([\n    page.goto('http://127.0.0.1:'+port+'/', {waitUntil:'load',timeout:15000}),\n    scriptResponse\n  ]);\n  if (!document || document.status() !== 200 || script.status() !== 200) throw new Error('Project entry resources unavailable');\n  console.log(JSON.stringify({node:process.version,playwright:require('playwright/package.json').version,chromium:browser.version(),documentStatus:document.status(),scriptStatus:script.status(),viewport:page.viewportSize()}));\n});\n"
      ],
