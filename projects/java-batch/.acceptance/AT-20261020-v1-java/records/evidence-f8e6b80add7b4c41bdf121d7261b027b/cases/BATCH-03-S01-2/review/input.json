  "requirement": {
    "id": "BATCH-03",
    "title": "BATCH-03",
    "text": "BATCH-03：成功时输出 UTF-8 CSV，表头固定为 `account,total_cents,event_count`，账户按字典序排列；退出码 0，标准错误为空。所有金额使用精确整数，输出每次相同。"
  },
  "scene": {
    "id": "BATCH-03-S01",
    "title": "普通成功输出符合交付格式",
    "priority": "P0",
    "priority_reason": "普通合法输入无法交付约定格式及成功信号，会阻断批处理结果的正常接收。",
    "description": "使用仅含 e1,alice,125 的合法输入和不存在的输出路径执行处理。输出须为有效 UTF-8 CSV，表头恰为 account,total_cents,event_count，数据行为 alice,125,1；退出码为 0，标准错误为空。",
    "requirement_id": "BATCH-03",
    "kind": "BLACK_BOX"
  },
  "business_goal": "通过本地批处理读取 UTF-8 收款事件 CSV，去重并按账户生成精确、排序稳定的收款汇总，遇到错误时整批失败并保护原有文件。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "BATCH-01",
      "BATCH-02",
      "BATCH-03",
      "BATCH-04",
      "BATCH-05",
      "BATCH-06"
    ],
    "exclusions": [
      "连接网络或数据库。",
      "支持 CSV 引号语法。",
      "覆盖已存在的输出文件。"
    ],
    "limitations": [
      "“普通本地机器”的配置及处理 1000 条合法记录的完成时限未明确。",
      "输入材料未提供当前实现满足全部业务规则的验证结果。"
    ]
  },
  "related_requirements": [
    {
      "id": "BATCH-01",
      "title": "BATCH-01",
      "text": "BATCH-01：命令接受 `--input <绝对路径>` 和 `--output <绝对路径>`，两者都必填。输入必须以 `event_id,account,amount_cents` 为唯一表头，并至少有一条数据行。每行恰好三列；event_id 和 account 是非空 ASCII 字母、数字、下划线或连字符，金额是 1 至 1000000000 的十进制整数。不支持 CSV 引号语法。"
    },
    {
      "id": "BATCH-02",
      "title": "BATCH-02",
      "text": "BATCH-02：对每个 account 汇总金额与不同 event_id 的笔数。相同 event_id、account、amount_cents 的重复行只处理一次；相同 event_id 对应不同内容时整批失败。账户名大小写敏感。"
    },
    {
      "id": "BATCH-04",
      "title": "BATCH-04",
      "text": "BATCH-04：任何参数、读取或数据错误都以退出码 2 失败，标准错误给出非空说明，不生成部分输出。若输出路径已存在，不覆盖它；输入文件保持原样。"
    },
    {
      "id": "BATCH-05",
      "title": "BATCH-05",
      "text": "BATCH-05：可从任意工作目录执行，输入和输出路径可位于不同目录。成功生成的输出文件可再次作为普通文件读取；程序不在输入目录创建临时文件。"
    },
    {
      "id": "BATCH-06",
      "title": "BATCH-06",
      "text": "BATCH-06：有 1000 条合法记录的文件应在普通本地机器上完成处理；空行、列数错误、无数据行都应给出 BATCH-04 规定的失败反馈。"
    }
  ],
