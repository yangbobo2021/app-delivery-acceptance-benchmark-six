    "command": [
      "/opt/homebrew/bin/python3",
      "-c",
      "import errno, fcntl, os, pathlib, pty, select, signal, struct, sys, tempfile, termios, time\ncargo, runtime = sys.argv[1:]\nos.environ.pop('NO_COLOR', None)\nwith tempfile.TemporaryDirectory(prefix='tui-smoke-', dir=runtime) as directory:\n    state = pathlib.Path(directory) / 'checklist.txt'\n    state.write_text('smoke1|Environment smoke|0\\n', encoding='utf-8')\n    pid, fd = pty.fork()\n    if pid == 0:\n        try:\n            fcntl.ioctl(0, termios.TIOCSWINSZ, struct.pack('HHHH', 24, 80, 0, 0))\n            os.execv(cargo, [cargo, 'run', '--quiet', '--locked', '--offline', '--', '--state', str(state)])\n        except BaseException as error:\n            os.write(2, str(error).encode('utf-8', errors='replace'))\n            os._exit(127)\n    status = None\n    sent_quit = False\n    output = bytearray()\n    deadline = time.monotonic() + 25\n    try:\n        while True:\n            finished, child_status = os.waitpid(pid, os.WNOHANG)\n            if finished:\n                status = child_status\n                break\n            if time.monotonic() >= deadline:\n                raise TimeoutError('PTY startup/quit timed out')\n            if select.select([fd], [], [], 0.1)[0]:\n                try:\n                    data = os.read(fd, 65536)\n                except OSError as error:\n                    if error.errno != errno.EIO:\n                        raise\n                    data = b''\n                if data:\n                    output.extend(data)\n                    if not sent_quit:\n                        os.write(fd, b'q')\n                        sent_quit = True\n        if not sent_quit or os.waitstatus_to_exitcode(status) != 0:\n            raise RuntimeError('PTY startup/quit failed; output: ' + bytes(output).decode('utf-8', errors='replace'))\n        print('PTY startup/quit OK; captured bytes:', len(output))\n    finally:\n        if status is None:\n            try:\n                os.killpg(pid, signal.SIGKILL)\n            except ProcessLookupError:\n                pass\n            os.waitpid(pid, 0)\n        os.close(fd)\n",
